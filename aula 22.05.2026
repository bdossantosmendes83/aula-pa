      "source": [
        "#6 - tabuada, o usuario digita um numero e o programa imprimi a tabuada do numero\n",
        "numero = int(input(\"digite um numero:\"))\n",
        "for i in range (1, 11):\n",
        "  print(numero, \"x\", i, \"=\", numero * i)"
      ],
