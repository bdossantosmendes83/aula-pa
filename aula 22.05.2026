    {
      "cell_type": "code",
      "source": [
        "#3 - numeros pares, o usuario digita um numero e o programa imprimi os numeros pares\n",
        "numero = int(input(\"digite um numero:\"))\n",
        "for i in range(numero + 1):\n",
        "  if i % 2 == 0:\n",
        "    print(i)"
      ],
