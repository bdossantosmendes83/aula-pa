      "cell_type": "code",
      "source": [
        "#5 - Soma, o usuario digita um numero e o programa soma os numeros do zero ate o numero\n",
        "numero = int(input(\"digite um numero:\"))\n",
        "soma = 0\n",
        "for i in range(numero + 1):\n",
        "  soma += i\n",
        "  print(\"A soma é:\", soma)"
      ],
