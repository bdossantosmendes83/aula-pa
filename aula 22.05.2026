    {
      "cell_type": "code",
      "source": [
        "# 8 - contar vogais, o usuario digita uma palavra e o programa conta as vogais\n",
        "palavra = input(\"Digite uma palavra:\")\n",
        "vogais = 0\n",
        "for letra in palavra:\n",
        "  if letra.lower() in \"aeiou\" :\n",
        "    vogais +=1\n",
        "    print(\"Quantidade de vogais\", vogais)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
