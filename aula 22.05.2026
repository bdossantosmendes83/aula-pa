      "cell_type": "code",
      "source": [
        "# 9 - maior numero digitado, o usuario digita quatro numeros e o programa imprimi o maior numero digitado.\n",
        "n1 = int(input(\"digite o primeiro numero:\"))\n",
        "n2 = int(input(\"digite o segundo numero:\"))\n",
        "n3 = int(input(\"digite o terceiro numero:\"))\n",
        "n4 = int(input(\"digite o quarto numero:\"))\n",
        "maior = max (n1, n2, n3, n4)\n",
        "print (\"O maior numero é:\", maior)"
      ],
      "metadata": {
        "colab": {
