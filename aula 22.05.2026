      "source": [
        "#1 - contagem simples, o usuario digite um numero e o programa imprimi do zero até o número\n",
        "numero = int(input(\"Digite um numero:\"))\n",
        "for i in range(numero + 1):\n",
        " print(i)\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#2 - contagem regressiva , o usuario digita um numero e o programa imprimi um numero até o zero\n",
        "numero = int(input(\"Digite um numero:\"))\n",
        "for i in range(numero, -1, -1):\n",
        "  print(i)"
      ],
