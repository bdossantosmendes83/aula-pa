    {
      "cell_type": "code",
      "source": [
        "# 10 - o usuario digita um numero entre 01 e 100 e o programa mostra quais são diviseis por 3 e 5\n",
        "numero = int(input(\"digite um numero entre 1 e 100: \"))\n",
        "for i in range(1, numero + 1):\n",
        "  if i % 3 == 0 and i % 5 == 0:\n",
        "    print (i)"
      ],
      "metadata": {
        "colab": {
